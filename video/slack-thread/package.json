{
  "name": "opendots-slack-thread",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "typecheck": "tsc --noEmit",
    "render:4k": "remotion render src/index.tsx OpenDots-Slack-Thread out/OpenDots-Slack-Thread-4K.mp4 --scale=2 --codec=h264 --crf=15 --pixel-format=yuv420p --concurrency=4",
    "render:prores": "remotion render src/index.tsx OpenDots-Slack-Thread out/OpenDots-Slack-Thread-4K-ProRes.mov --scale=2 --codec=prores --prores-profile=standard --pixel-format=yuv422p10le --concurrency=4",
    "render:1080p": "remotion render src/index.tsx OpenDots-Slack-Thread out/OpenDots-Slack-Thread-1080p.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --concurrency=4",
    "still": "remotion still src/index.tsx OpenDots-Slack-Thread out/preview.png --frame=890 --scale=2"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
